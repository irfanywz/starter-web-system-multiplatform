# Alamat dan port.
# 127.0.0.1 = hanya bisa diakses dari mesin ini (aman untuk RDP/laptop).
# 0.0.0.0   = bisa diakses dari jaringan (pasang HTTPS di depannya).
HOST=127.0.0.1
PORT=3000

# Shell default.
# Windows: powershell | cmd
# Linux/macOS: sh | bash
# Kosongkan untuk pakai default OS.
# DEFAULT_SHELL=

# Folder kerja default untuk perintah. Kosong = folder project ini.
# DEFAULT_CWD=

# Batas waktu job dalam detik (default 600).
JOB_TIMEOUT_SEC=600

# Jumlah job yang boleh berjalan bersamaan.
MAX_CONCURRENT_JOBS=5

# Lama sesi login dalam jam.
SESSION_HOURS=12

# Set true kalau sudah pakai HTTPS (reverse proxy).
COOKIE_SECURE=false

# Set 1 kalau di belakang reverse proxy (Caddy/nginx/IIS ARR).
# TRUST_PROXY=1

# Lokasi database (opsional).
# DB_PATH=./data/app.db
